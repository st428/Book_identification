# Python cache
__pycache__/
*.py[cod]

# Web runtime cache and uploads
stage5_mobile_results/uploads/
stage5_mobile_results/results/
stage5_mobile_results/reviews/
stage5_mobile_results/debug*/
stage5_mobile_results/*probe*/
stage5_mobile_results/*extract*/

# Keep final demo outputs, but avoid accidental large debug exports.
!stage5_mobile_results/final_demo_results/

# Local full image dataset is kept in final/data but is too large for normal Git.
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.webp
!data/README.md
